{
    "version": 1,
    "corpus": "atelier-bench-corpus",
    "lane": "fixture",
    "notes": "Scorer fixture, not a lane: one task per verdict and per must_not_include form. s-unresolved points at a file that does not exist on purpose, so no lane verifier is run over this directory.",
    "tasks": [
        {
            "id": "s-pass",
            "surface": "definition",
            "note": "The target line is returned and nothing else.",
            "from": { "file": "src/app.txt", "needle": "gamma uses alpha", "symbol": "alpha" },
            "expect": { "file": "src/app.txt", "needle": "alpha declaration" }
        },
        {
            "id": "s-wrong-line",
            "surface": "definition",
            "note": "A neighbouring line is returned: declarations match by exact line.",
            "from": { "file": "src/app.txt", "needle": "gamma uses alpha", "symbol": "alpha" },
            "expect": { "file": "src/app.txt", "needle": "beta declaration" }
        },
        {
            "id": "s-ambiguous",
            "surface": "definition",
            "note": "The target is returned with a second, unexpected location.",
            "from": { "file": "src/app.txt", "needle": "gamma uses alpha", "symbol": "alpha" },
            "expect": { "file": "src/app.txt", "needle": "epsilon target" }
        },
        {
            "id": "s-known-site",
            "surface": "definition",
            "note": "The extra location covers a known site by range, which is allowed.",
            "from": { "file": "src/app.txt", "needle": "gamma uses alpha", "symbol": "alpha" },
            "expect": {
                "file": "src/app.txt",
                "needle": "alpha declaration",
                "known_sites": [ { "file": "src/app.txt", "needle": "delta site" } ]
            }
        },
        {
            "id": "s-known-site-excluded-path",
            "surface": "definition",
            "note": "A known site sits in a file the task also excludes: the key lists it, so it is not an excluded hit.",
            "from": { "file": "src/app.txt", "needle": "gamma uses alpha", "symbol": "alpha" },
            "expect": {
                "file": "src/app.txt",
                "needle": "alpha declaration",
                "known_sites": [ { "file": "src/other.txt", "needle": "other file line" } ],
                "must_not_include": [ "src/other.txt" ]
            }
        },
        {
            "id": "s-range-over-excluded-text",
            "surface": "definition",
            "note": "The target is returned with a range whose body contains excluded text: only the reported line is searched.",
            "from": { "file": "src/app.txt", "needle": "gamma uses alpha", "symbol": "alpha" },
            "expect": {
                "file": "src/app.txt",
                "needle": "delta site",
                "must_not_include": [ "impl .* for Money", "Right" ]
            }
        },
        {
            "id": "s-lane-prefix",
            "surface": "resolution",
            "note": "Exclusion written as a lane prefix: a location in another lane.",
            "from": { "file": "src/app.txt", "needle": "gamma uses alpha", "symbol": "alpha" },
            "expect": {
                "kind": "lane_local",
                "candidate": { "file": "src/app.txt", "needle": "alpha declaration" },
                "must_not_include": [ "php/" ]
            }
        },
        {
            "id": "s-path",
            "surface": "import-precision",
            "note": "Exclusion written as a path.",
            "from": { "file": "src/app.txt", "needle": "gamma uses alpha", "symbol": "alpha" },
            "expect": {
                "kind": "imports",
                "candidate": { "file": "src/app.txt", "needle": "beta declaration" },
                "must_not_include": [ "src/other.txt" ]
            }
        },
        {
            "id": "s-path-symbol",
            "surface": "resolution",
            "note": "Exclusion written as path#symbol.",
            "from": { "file": "src/app.txt", "needle": "gamma uses alpha", "symbol": "alpha" },
            "expect": {
                "kind": "same_name",
                "candidate": { "file": "src/app.txt", "needle": "epsilon target" },
                "must_not_include": [ "src/app.txt#Right" ]
            }
        },
        {
            "id": "s-pattern",
            "surface": "definition",
            "note": "Exclusion written as a pattern with a wildcard.",
            "from": { "file": "src/app.txt", "needle": "gamma uses alpha", "symbol": "alpha" },
            "expect": {
                "file": "src/app.txt",
                "needle": "delta site",
                "must_not_include": [ "impl .* for Money" ]
            }
        },
        {
            "id": "s-text",
            "surface": "definition",
            "note": "Exclusion matched in the answer's free text, with a correct location.",
            "from": { "file": "src/app.txt", "needle": "gamma uses alpha", "symbol": "alpha" },
            "expect": {
                "file": "src/app.txt",
                "needle": "alpha declaration",
                "must_not_include": [ "forbidden phrase" ]
            }
        },
        {
            "id": "s-not-scored",
            "surface": "definition",
            "note": "A key no rule uses is listed as not scored; a label key is not listed.",
            "from": { "file": "src/app.txt", "needle": "gamma uses alpha", "symbol": "alpha" },
            "expect": {
                "kind": "string_key",
                "file": "src/app.txt",
                "needle": "beta declaration",
                "must_include": [ "beta" ]
            }
        },
        {
            "id": "s-empty",
            "surface": "definition",
            "note": "Answered, with no location.",
            "from": { "file": "src/app.txt", "needle": "gamma uses alpha", "symbol": "alpha" },
            "expect": { "file": "src/app.txt", "needle": "alpha declaration" }
        },
        {
            "id": "s-unsupported",
            "surface": "definition",
            "note": "The adapter says the tool cannot be asked this.",
            "from": { "file": "src/app.txt", "needle": "gamma uses alpha", "symbol": "alpha" },
            "expect": { "file": "src/app.txt", "needle": "alpha declaration" }
        },
        {
            "id": "s-error",
            "surface": "definition",
            "note": "The adapter reports that the tool failed.",
            "from": { "file": "src/app.txt", "needle": "gamma uses alpha", "symbol": "alpha" },
            "expect": { "file": "src/app.txt", "needle": "alpha declaration" }
        },
        {
            "id": "s-invalid",
            "surface": "definition",
            "note": "The answer is malformed.",
            "from": { "file": "src/app.txt", "needle": "gamma uses alpha", "symbol": "alpha" },
            "expect": { "file": "src/app.txt", "needle": "alpha declaration" }
        },
        {
            "id": "s-unanswered",
            "surface": "definition",
            "note": "The answer file has no entry for this task.",
            "from": { "file": "src/app.txt", "needle": "gamma uses alpha", "symbol": "alpha" },
            "expect": { "file": "src/app.txt", "needle": "alpha declaration" }
        },
        {
            "id": "s-unscorable-surface",
            "surface": "parse-negative",
            "note": "No rule serves this surface yet.",
            "from": { "file": "src/app.txt", "needle": "gamma uses alpha" },
            "expect": { "kind": "syntax_error", "must_include": "alpha" }
        },
        {
            "id": "s-hover-pass",
            "surface": "hover",
            "note": "The answer's text contains the key's string; surrounding text is not judged (recall).",
            "from": { "file": "src/app.txt", "needle": "gamma uses alpha", "symbol": "alpha" },
            "expect": { "contains": "alpha declaration" }
        },
        {
            "id": "s-hover-miss",
            "surface": "hover",
            "note": "The answer's text lacks the key's string.",
            "from": { "file": "src/app.txt", "needle": "gamma uses alpha", "symbol": "alpha" },
            "expect": { "contains": "beta declaration" }
        },
        {
            "id": "s-callees",
            "surface": "call_hierarchy",
            "note": "Every listed callee is returned by exact line; an extra callee is not judged (recall).",
            "from": { "file": "src/app.txt", "needle": "gamma uses alpha", "symbol": "gamma" },
            "expect": { "outgoing_includes": [ { "file": "src/app.txt", "needle": "alpha declaration" }, { "file": "src/app.txt", "needle": "beta declaration" } ] }
        },
        {
            "id": "s-callees-missing",
            "surface": "call_hierarchy",
            "note": "One listed callee is not returned.",
            "from": { "file": "src/app.txt", "needle": "gamma uses alpha", "symbol": "gamma" },
            "expect": { "outgoing_includes": [ { "file": "src/app.txt", "needle": "alpha declaration" }, { "file": "src/app.txt", "needle": "beta declaration" } ] }
        },
        {
            "id": "s-callers",
            "surface": "call_hierarchy",
            "note": "Every listed call site is covered by a returned caller's range.",
            "from": { "file": "src/app.txt", "needle": "alpha declaration", "symbol": "alpha" },
            "expect": { "incoming_includes": [ { "file": "src/app.txt", "needle": "gamma uses alpha" }, { "file": "src/app.txt", "needle": "delta site" } ], "min_incoming": 2 }
        },
        {
            "id": "s-callers-missing",
            "surface": "call_hierarchy",
            "note": "One listed call site lies outside every returned range.",
            "from": { "file": "src/app.txt", "needle": "alpha declaration", "symbol": "alpha" },
            "expect": { "incoming_includes": [ { "file": "src/app.txt", "needle": "gamma uses alpha" }, { "file": "src/app.txt", "needle": "epsilon target" } ] }
        },
        {
            "id": "s-refs",
            "surface": "references",
            "note": "Every site by its line; the declaration asked from and an optional site may be returned too.",
            "from": { "file": "src/app.txt", "needle": "alpha declaration", "symbol": "alpha" },
            "expect": { "exact_count": 2, "known_sites": [ { "file": "src/app.txt", "needle": "gamma uses alpha" }, { "file": "src/app.txt", "needle": "delta site" } ], "optional_sites": [ { "file": "src/other.txt", "needle": "other file line" } ] }
        },
        {
            "id": "s-refs-extra",
            "surface": "references",
            "note": "Every site returned, plus a line that is not a site.",
            "from": { "file": "src/app.txt", "needle": "alpha declaration", "symbol": "alpha" },
            "expect": { "exact_count": 2, "known_sites": [ { "file": "src/app.txt", "needle": "gamma uses alpha" }, { "file": "src/app.txt", "needle": "delta site" } ] }
        },
        {
            "id": "s-refs-range",
            "surface": "references",
            "note": "One range over the sites is not the sites: a site is matched by its line.",
            "from": { "file": "src/app.txt", "needle": "alpha declaration", "symbol": "alpha" },
            "expect": { "exact_count": 2, "known_sites": [ { "file": "src/app.txt", "needle": "gamma uses alpha" }, { "file": "src/app.txt", "needle": "delta site" } ] }
        },
        {
            "id": "s-refs-floor",
            "surface": "references",
            "note": "A floor beside a count: the list is not known to be complete.",
            "from": { "file": "src/app.txt", "needle": "alpha declaration", "symbol": "alpha" },
            "expect": { "exact_count": 1, "min_references": 1, "known_sites": [ { "file": "src/app.txt", "needle": "gamma uses alpha" } ] }
        },
        {
            "id": "s-unscorable-count",
            "surface": "definition",
            "note": "A target with exact_count: what the count means depends on kind, so no rule scores it.",
            "from": { "file": "src/app.txt", "needle": "gamma uses alpha", "symbol": "alpha" },
            "expect": { "file": "src/app.txt", "needle": "alpha declaration", "exact_count": 2 }
        },
        {
            "id": "s-no-symbol",
            "surface": "definition",
            "note": "States no from.symbol, so no adapter can be asked it: unscorable, even with a perfect answer.",
            "from": { "file": "src/app.txt", "needle": "gamma uses alpha" },
            "expect": { "file": "src/app.txt", "needle": "alpha declaration" }
        },
        {
            "id": "s-unresolved",
            "surface": "definition",
            "note": "The expected file is not in the checkout.",
            "from": { "file": "src/app.txt", "needle": "gamma uses alpha", "symbol": "alpha" },
            "expect": { "file": "src/absent.txt", "needle": "x" }
        }
    ]
}
